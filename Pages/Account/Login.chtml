@page
@model aspnetWebApp.Pages.Account.LoginModel

<h1>Вход в аккаунт</h1>

<form method="post">
    <div>
        <label asp-net-for="input.Email">Email</label>
        <input asp-net-for="Input.Email" type="email">
        <span asp-validation-for="Input.Email"></span>
    </div>
    <div>
        <label asp-net-for="input.Password">Пароль</label>
        <input asp-net-for="Input.Password" type="password">
        <span asp-validation-for="Input.Password"></span>
    </div>
    <div>
        <label asp-net-for="input.ConfirmPassword">Повторите пароль</label>
        <input asp-net-for="Input.ConfirmPassword" type="password">
        <span asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit">Войти</button>
</form>

<div asp-validation-summary="All"></div>